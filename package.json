{
  "name": "sussydev-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt",
    "extract:anims": "node scripts/extract-rbxm-anims.ts",
    "build:model": "/Applications/Blender.app/Contents/MacOS/Blender -b -P scripts/blender/build-sussy.py && npm run optimize:model",
    "optimize:model": "gltf-transform optimize public/models/sussy/sussy-r6.glb public/models/sussy/sussy-r6.glb --compress meshopt --texture-compress webp --texture-size 512 --simplify false --join false --instance false --flatten false",
    "test:e2e": "playwright test",
    "build:nature": "/Applications/Blender.app/Contents/MacOS/Blender -b -P scripts/blender/build-nature.py && npm run optimize:nature",
    "optimize:nature": "gltf-transform optimize public/models/nature/nature.glb public/models/nature/nature.glb --compress meshopt --simplify false --join false --instance false --flatten false",
    "build:props": "/Applications/Blender.app/Contents/MacOS/Blender -b -P scripts/blender/build-props.py && npm run optimize:props",
    "optimize:props": "gltf-transform optimize public/models/props/props.glb public/models/props/props.glb --compress meshopt --simplify false --join false --instance false --flatten false --palette false"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "lucide-react": "1.31.0",
    "nitro": "3.0.260903-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "simple-icons": "^15.22.0",
    "three": "^0.185.1",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "draco3d": "^1.5.7",
    "happy-dom": "20.14.6",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "5.0.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
